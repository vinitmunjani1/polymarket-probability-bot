# dry-run by default; set EXECUTION_MODE=live only after reviewing logs
EXECUTION_MODE=dry-run

ASSETS=BTC,ETH,SOL,XRP
WINDOW_SECONDS=300
ORDER_NOTIONAL_USD=1.00
MAX_ORDERS_PER_MARKET_WINDOW=1
DRY_CAPITAL_PER_ASSET_USD=10.00
DRY_CHARGE_RATE_BPS=0.0
DRY_FIXED_CHARGE_USD=0.0

# Strategy gates
MIN_EDGE_CENTS=3.0
MAX_SPREAD_CENTS=3.0
MIN_TIME_REMAINING_SECONDS=20
MAX_TIME_REMAINING_SECONDS=260
MIN_ENTRY_PRICE=0.70
MAX_ENTRY_PRICE=0.99
MIN_SIGNAL_PRICE=0.84
# edge = model fair - executable ask; edge_or_signal also allows market-price signal >= MIN_SIGNAL_PRICE
TRADE_TRIGGER_MODE=edge_or_signal

# Polymarket / Polygon live trading; required only for EXECUTION_MODE=live
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=1
CLOB_API_CREDS_PATH=./clob_api_creds.json
